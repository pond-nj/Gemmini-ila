# Bug 7: funct 1 is mvin2 (load pipeline 1). The old ILA decodes funct 1 as
# matmul.compute.atomic, which is not in the official ISA.
# Where: include/gemmini.h:37 defines funct 1 as matmul_compute_atomic, decoded at
#   src/gemmini.cc:369-370. Missing: an mvin2 instruction.
# Spec: RTL GemminiISA.scala:9, LOAD2_CMD = 1; LoadController.scala:61-62 maps it to load
#   state 1. README.md:411 names mvin2 but not its funct.
# Expected: scratchpad row 0 col 0 = 7.
# Old ILA: runs matmul.compute.atomic instead of the load, so row 0 col 0 = 0.
config funct=0 rs1=0x3f80000000100009 rs2=0x0000000000000010
.mem 0x10000 07
mvin2  funct=1 rs1=0x0000000000010000 rs2=0x0001000100000000
